{
  "id": "2026-11-25-001-backfill-catalog",
  "description": "Copy catalog labels under their original IDs",
  "steps": [{
    "collection": "legacyCatalog",
    "operation": "aggregate",
    "pipeline": [
      { "$sort": { "_id": 1 } },
      { "$project": { "_id": 1, "label": 1 } },
      { "$merge": { "into": "catalog", "whenMatched": "merge", "whenNotMatched": "insert" } }
    ]
  }]
}
