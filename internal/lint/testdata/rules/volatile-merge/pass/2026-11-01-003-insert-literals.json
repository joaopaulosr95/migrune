{
  "id": "2026-11-01-003-insert-literals",
  "description": "Store operator names as literal metadata",
  "steps": [
    {
      "collection": "legacyCatalog",
      "operation": "aggregate",
      "pipeline": [
        { "$match": { "metadata": { "$eq": { "$sample": "unit" } }, "nested": { "tag": { "$sample": "unit" } }, "array": [{ "$sample": "unit" }] } },
        { "$match": { "tags": { "$all": [[{ "$sample": "unit" }], { "kind": "tag", "$elemMatch": { "$sample": "unit" } }] } } },
        { "$set": {
          "metadata": { "$literal": { "$sample": "unit" } },
          "history": { "$const": [{ "$sampleRate": 1, "$createObjectId": {} }] }
        } },
        { "$merge": { "into": "catalog", "whenMatched": "merge", "whenNotMatched": "insert" } }
      ]
    }
  ]
}
