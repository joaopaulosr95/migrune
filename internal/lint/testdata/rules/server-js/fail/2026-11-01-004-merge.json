{
  "id": "2026-11-01-004-merge",
  "description": "test fixture",
  "steps": [
    {
      "collection": "projects",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "$where": "this.n > 1"
          }
        },
        {
          "$project": {
            "slug": {
              "$function": {
                "body": "function(n) { return n.toLowerCase() }",
                "args": [
                  "$name"
                ],
                "lang": "js"
              }
            }
          }
        },
        {
          "$merge": {
            "into": "projects",
            "whenMatched": "merge",
            "whenNotMatched": "discard"
          }
        }
      ]
    }
  ]
}
