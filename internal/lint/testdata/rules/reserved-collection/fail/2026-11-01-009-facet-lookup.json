{
  "id": "2026-11-01-009-facet-lookup",
  "description": "Read the lock inside a facet",
  "steps": [
    {
      "collection": "items",
      "operation": "aggregate",
      "pipeline": [
        { "$facet": { "locks": [{ "$lookup": { "from": "migrations_lock", "pipeline": [], "as": "lock" } }] } },
        { "$unwind": "$locks" },
        { "$replaceWith": "$locks" },
        { "$merge": { "into": "items", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
