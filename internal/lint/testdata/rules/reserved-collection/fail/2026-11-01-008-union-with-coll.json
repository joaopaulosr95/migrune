{
  "id": "2026-11-01-008-union-with-coll",
  "description": "Read stored functions",
  "steps": [
    {
      "collection": "items",
      "operation": "aggregate",
      "pipeline": [
        { "$unionWith": { "coll": "system.js", "pipeline": [{ "$project": { "_id": 1 } }] } },
        { "$merge": { "into": "items", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
