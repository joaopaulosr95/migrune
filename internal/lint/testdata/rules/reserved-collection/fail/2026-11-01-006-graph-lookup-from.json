{
  "id": "2026-11-01-006-graph-lookup-from",
  "description": "Walk the users of the database",
  "steps": [
    {
      "collection": "items",
      "operation": "aggregate",
      "pipeline": [
        { "$graphLookup": { "from": "system.users", "startWith": "$owner", "connectFromField": "user", "connectToField": "user", "as": "users" } },
        { "$merge": { "into": "items", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
