{
  "id": "2026-11-05-001-read",
  "description": "Default archived to false on existing projects",
  "steps": [
    {
      "collection": "projects",
      "operation": "updateMany",
      "filter": { "archived": { "$exists": false } },
      "update": { "$set": { "archived": false } }
    },
    {
      "collection": "projects",
      "operation": "updateMany",
      "filter": { "archivedAt": { "$exists": false }, "archived": true },
      "update": [{ "$set": { "archivedAt": "$updatedAt" } }]
    },
    {
      "collection": "projects",
      "operation": "deleteMany",
      "filter": {
        "_id": { "$oid": "64b7f0c2a1b2c3d4e5f60718" },
        "createdAt": { "$lt": { "$date": "2020-01-01T00:00:00Z" } }
      }
    }
  ]
}
