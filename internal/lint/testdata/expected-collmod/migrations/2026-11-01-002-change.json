{
  "id": "2026-11-01-002-change",
  "description": "Expire events, hide the legacy index, prepare two unique conversions",
  "steps": [
    {
      "collection": "events",
      "operation": "collModIndex",
      "name": "createdAt_1",
      "set": {
        "expireAfterSeconds": 2592000
      }
    },
    {
      "collection": "items",
      "operation": "collModIndex",
      "name": "legacy_1",
      "set": {
        "hidden": true
      }
    },
    {
      "collection": "users",
      "operation": "collModIndex",
      "name": "email_1",
      "set": {
        "prepareUnique": true
      }
    },
    {
      "collection": "orders",
      "operation": "collModIndex",
      "name": "ref_1",
      "set": {
        "prepareUnique": true
      }
    }
  ]
}
