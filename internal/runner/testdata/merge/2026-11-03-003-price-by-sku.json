{
  "id": "2026-11-03-003-price-by-sku",
  "description": "Copy each source's price onto the item with the same sku",
  "steps": [
    {
      "collection": "sources",
      "operation": "aggregate",
      "pipeline": [
        { "$project": { "_id": 0, "sku": 1, "price": 1 } },
        { "$merge": { "into": "items", "on": "sku", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
