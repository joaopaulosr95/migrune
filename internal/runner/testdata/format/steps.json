{
  "steps": [
    {
      "collection": "projects",
      "operation": "updateOne",
      "filter": { "_id": 1 },
      "update": { "$set": { "archived": false } },
      "options": { "upsert": true }
    },
    {
      "collection": "projects",
      "operation": "updateMany",
      "filter": { "archived": { "$exists": false } },
      "update": [{ "$set": { "archived": false } }],
      "options": { "arrayFilters": [{ "x.done": true }], "hint": { "archived": 1 } }
    },
    { "collection": "projects", "operation": "deleteMany", "filter": { "stale": true } },
    {
      "collection": "accounts",
      "operation": "createIndex",
      "keys": { "name": 1 },
      "options": { "name": "name_1_ci", "unique": true, "collation": { "locale": "en", "strength": 2 } }
    },
    { "collection": "accounts", "operation": "dropIndex", "name": "name_1" },
    { "collection": "events", "operation": "collModIndex", "name": "dedupeKey_1", "set": { "unique": true } },
    {
      "collection": "accounts",
      "operation": "aggregate",
      "pipeline": [
        { "$project": { "ownerName": "$owner.name" } },
        { "$merge": { "into": "projects", "on": "_id", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
