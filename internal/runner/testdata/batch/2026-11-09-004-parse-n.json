{
  "id": "2026-11-09-004-parse-n",
  "description": "Parse v into n, ten items at a time",
  "batchSize": 10,
  "steps": [
    {
      "collection": "items",
      "operation": "updateMany",
      "filter": { "n": { "$exists": false } },
      "update": [{ "$set": { "n": { "$toInt": "$v" } } }]
    }
  ]
}
