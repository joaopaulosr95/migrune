{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration",
  "description": "Migration file schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{3}-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "YYYY-MM-DD-NNN-slug, must match the file name stem"
    },
    "description": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false,
  "required": ["id", "description", "steps"],
  "oneOf": [
    { "properties": { "steps": { "items": { "$ref": "#/$defs/dataStep" } } } },
    { "properties": { "steps": { "items": { "$ref": "#/$defs/indexStep" } } } },
    { "properties": { "steps": { "items": { "$ref": "#/$defs/mergeStep" } } } }
  ],
  "$defs": {
    "collection": {
      "type": "string",
      "minLength": 1,
      "not": { "$ref": "#/$defs/reservedCollection" }
    },
    "reservedCollection": {
      "description": "migrune's own collections and MongoDB's system collections, which migrations must not name",
      "anyOf": [{ "enum": ["migrations_changelog", "migrations_lock"] }, { "pattern": "^system\\." }]
    },
    "noOut": {
      "description": "A pipeline stage other than $out, which replaces the whole target collection",
      "not": { "required": ["$out"] }
    },
    "noMerge": {
      "description": "A pipeline stage other than $merge, which only a merge step's pipeline may end with",
      "not": { "required": ["$merge"] }
    },
    "dataStep": {
      "type": "object",
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "operation": { "enum": ["updateOne", "updateMany", "deleteMany"] },
        "filter": { "type": "object" },
        "update": {
          "description": "An update document, or an update pipeline",
          "type": ["object", "array"],
          "if": { "type": "array" },
          "then": {
            "minItems": 1,
            "items": { "type": "object", "allOf": [{ "$ref": "#/$defs/noOut" }, { "$ref": "#/$defs/noMerge" }] }
          }
        },
        "options": { "type": "object" }
      },
      "additionalProperties": false,
      "required": ["collection", "operation", "filter"],
      "if": { "properties": { "operation": { "enum": ["updateOne", "updateMany"] } } },
      "then": { "required": ["update"] },
      "else": { "not": { "required": ["update"] } }
    },
    "indexStep": {
      "type": "object",
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "operation": { "enum": ["createIndex", "dropIndex", "collModIndex", "collModCollection"] },
        "keys": { "type": "object", "minProperties": 1 },
        "options": {
          "type": "object",
          "properties": { "name": { "type": "string", "minLength": 1 } },
          "required": ["name"]
        },
        "name": { "type": "string", "minLength": 1 },
        "set": { "type": "object" }
      },
      "additionalProperties": false,
      "required": ["collection", "operation"],
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "createIndex" } } },
          "then": {
            "required": ["keys", "options"],
            "allOf": [{ "not": { "required": ["name"] } }, { "not": { "required": ["set"] } }]
          }
        },
        {
          "if": { "properties": { "operation": { "const": "dropIndex" } } },
          "then": {
            "required": ["name"],
            "allOf": [{ "not": { "anyOf": [{ "required": ["keys"] }, { "required": ["options"] }] } }, { "not": { "required": ["set"] } }]
          }
        },
        {
          "if": { "properties": { "operation": { "const": "collModIndex" } } },
          "then": {
            "required": ["name", "set"],
            "properties": { "set": { "$ref": "#/$defs/indexSet" } },
            "not": { "anyOf": [{ "required": ["keys"] }, { "required": ["options"] }] }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "collModCollection" } } },
          "then": {
            "required": ["set"],
            "properties": { "set": { "$ref": "#/$defs/collectionSet" } },
            "not": { "anyOf": [{ "required": ["keys"] }, { "required": ["options"] }, { "required": ["name"] }] }
          }
        }
      ]
    },
    "indexSet": {
      "description": "The options a collModIndex step changes on an existing index, at least one",
      "type": "object",
      "properties": {
        "expireAfterSeconds": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "hidden": { "type": "boolean" },
        "prepareUnique": { "const": true },
        "unique": { "const": true }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "not": { "required": ["prepareUnique"], "minProperties": 2 }
    },
    "collectionSet": {
      "description": "The validation options a collModCollection step changes on an existing collection, at least one",
      "type": "object",
      "properties": {
        "validator": { "type": "object" },
        "validationLevel": { "enum": ["off", "strict", "moderate"] },
        "validationAction": { "enum": ["error", "warn"] }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "mergeStep": {
      "type": "object",
      "properties": {
        "collection": { "$ref": "#/$defs/collection" },
        "operation": { "const": "aggregate" },
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "allOf": [{ "$ref": "#/$defs/noOut" }],
            "properties": { "$merge": { "$ref": "#/$defs/merge" } }
          },
          "contains": { "required": ["$merge"] },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "additionalProperties": false,
      "required": ["collection", "operation", "pipeline"]
    },
    "merge": {
      "description": "The $merge stage of a merge step: it updates matched documents in place and writes nothing else",
      "type": "object",
      "properties": {
        "into": { "$ref": "#/$defs/collection" },
        "on": {
          "description": "A field name, or an array of distinct field names; _id when absent",
          "type": ["string", "array"],
          "minLength": 1,
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "whenMatched": { "const": "merge" },
        "whenNotMatched": { "const": "discard" }
      },
      "additionalProperties": false,
      "required": ["into", "whenMatched", "whenNotMatched"]
    }
  }
}
