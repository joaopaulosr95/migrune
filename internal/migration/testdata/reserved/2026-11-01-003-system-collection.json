{
  "id": "2026-11-01-003-system-collection",
  "description": "Read a system collection",
  "steps": [
    {
      "collection": "system.views",
      "operation": "aggregate",
      "pipeline": [
        { "$project": { "viewOn": 1 } },
        { "$merge": { "into": "views", "whenMatched": "merge", "whenNotMatched": "discard" } }
      ]
    }
  ]
}
