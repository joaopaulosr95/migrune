{
  "id": "2026-11-05-002-seed-price-table-v1",
  "description": "Seed version 1 of the price table",
  "steps": [
    {
      "collection": "pricetables",
      "operation": "updateOne",
      "filter": { "version": 1 },
      "update": {
        "$setOnInsert": {
          "version": 1,
          "prices": { "basic": { "$numberDecimal": "9.99" }, "pro": { "$numberLong": "29" } }
        }
      },
      "options": { "upsert": true }
    }
  ]
}
